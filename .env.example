# Local development uses file:./data/menu.db by default.
# Production uses the live database. Dev and local must not. See docs/environments.md.
CMS_DATABASE_URL=file:./data/menu.db
# For Vercel use libsql://... and the database token (never NEXT_PUBLIC).
CMS_DATABASE_AUTH_TOKEN=
# Admin sign-in is disabled until both are set. Choose your own values,
# and a long, unique password on any deployed site. Dev uses a different password.
CMS_ADMIN_USERNAME=
CMS_ADMIN_PASSWORD=
# report logs a bad database setup and continues. enforce refuses to start.
CMS_ENV_GUARD=report
# Empty selects mock locally/in preview, counter (pay at pickup) in production.
# Explicit mock is forbidden in production. Ordering always refuses the live DB.
# Set to sadad only when SADAD_* below are present (test-dev sandbox first).
PAYMENT_PROVIDER=

# Sadad WebCheckout 2.1 — online pay before car-collection pickup (not delivery).
# Leave unset locally to keep the mock gateway. Never commit real secrets.
SADAD_SECRET_KEY=
SADAD_MERCHANT_ID=
# Public https origin of this deployment (no trailing slash), e.g. https://test-dev-….vercel.app
SADAD_PUBLIC_ORIGIN=

# Optional read-only published-menu source for an isolated demonstration site.
CMS_PUBLIC_MENU_SOURCE_URL=
