# Local development uses file:./data/menu.db by default.
# Production uses the live database. Dev and local must not. See docs/environments.md.
CMS_DATABASE_URL=file:./data/menu.db
# For Vercel use libsql://... and the database token (never NEXT_PUBLIC).
CMS_DATABASE_AUTH_TOKEN=
# Admin sign-in is disabled until both are set. Choose your own values,
# and a long, unique password on any deployed site. Dev uses a different password.
CMS_ADMIN_USERNAME=
CMS_ADMIN_PASSWORD=
# report logs a bad database setup and continues. enforce refuses to start.
CMS_ENV_GUARD=report
# Later. Production must not be mock. Leave empty until payments exist.
PAYMENT_PROVIDER=
