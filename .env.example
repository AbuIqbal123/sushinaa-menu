# Development uses file:./data/menu.db by default.
CMS_DATABASE_URL=file:./data/menu.db
# For Vercel use libsql://... and the database token (never NEXT_PUBLIC).
CMS_DATABASE_AUTH_TOKEN=
# Local development only. Sign-in is disabled when either value is missing.
# Use a long, unique password on any deployed site.
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=admin
