# Development uses file:./data/menu.db by default.
CMS_DATABASE_URL=file:./data/menu.db
# For Vercel use libsql://... and the database token (never NEXT_PUBLIC).
CMS_DATABASE_AUTH_TOKEN=
# Admin sign-in is disabled until both are set. Choose your own values,
# and a long, unique password on any deployed site.
CMS_ADMIN_USERNAME=
CMS_ADMIN_PASSWORD=

# Stage 2: private local preview only; production checkout is explicitly disabled.
ORDERING_PREVIEW_ENABLED=false
# Separate order storage. Do not point at the production CMS database.
ORDER_DATABASE_URL=file:./data/orders.db
ORDER_DATABASE_AUTH_TOKEN=

# Reserved server-only configuration for the future verified Sadad adapter.
# These values alone DO NOT enable payments in this branch.
SADAD_MERCHANT_ID=
SADAD_WEBSITE=
SADAD_TEST_SECRET_KEY=
SADAD_CALLBACK_URL=
SADAD_WEBHOOK_URL=
